RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Premium QR Menu product links.
#
# NEXT_PUBLIC_* values are inlined at build time, so changing one needs a
# rebuild, not just a restart.
# ---------------------------------------------------------------------------

# The working demo anyone can click into.
NEXT_PUBLIC_QR_MENU_DEMO_URL=https://demo.qr-menu.setutechnology.com/

# The dashboard. "Create your account" links point at <this>/signup.
NEXT_PUBLIC_QR_MENU_APP_URL=https://app.qr-menu.setutechnology.com/

# On unless explicitly "false". Set it to false to point every "get started"
# link back at the product page — useful if the app needs to come down without
# shipping a code change.
NEXT_PUBLIC_QR_MENU_APP_ENABLED=true

# ---------------------------------------------------------------------------
# URL shortener (optional).
#
# Leave these unset and every share link stays exactly as it was: the whole
# document travels inside the link, nothing is uploaded, and no shortening UI
# appears anywhere in the tools.
#
# Set all three to enable it. The service itself lives in the URL-shoternd-API
# repo (Express + MongoDB Atlas, deployed on Railway).
# ---------------------------------------------------------------------------

# Base URL of the deployed shortener. Server-side only — never NEXT_PUBLIC_.
SHORTENER_API_URL=https://setu-url-shortener.up.railway.app

# Must match API_KEY on the shortener service. This is the only thing stopping
# it from being an open shortener, so it must never reach a browser: keep it
# out of NEXT_PUBLIC_ variables and out of client components.
SHORTENER_API_KEY=

# Whether the tools show the "Shorten" button at all. Inlined at build time, so
# changing it needs a rebuild rather than a restart. Set to "true" only once the
# two values above are actually configured.
NEXT_PUBLIC_SHORT_LINKS_ENABLED=false

# ---------------------------------------------------------------------------
# Nepal flood relief banner.
#
# A dismissible bar above the nav asking visitors to donate to the Government
# of Nepal's relief portal. All three are optional — with none of them set the
# banner shows on every page, indefinitely.
#
# NEXT_PUBLIC_* values are inlined at build time, so changing one needs a
# rebuild. The dates are the exception: they are compared against the
# visitor's clock in the browser, so a window that closes takes the banner
# down on its own without waiting for a redeploy.
# ---------------------------------------------------------------------------

# On unless explicitly "false". Set it to false to pull the banner site-wide.
NEXT_PUBLIC_NEPAL_BANNER_ENABLED=true

# Optional window. Either bound can be left empty, and both accept a bare
# YYYY-MM-DD or a full ISO timestamp ("2026-10-31T18:30:00Z"). A bare end date
# runs through the whole of that day; a timestamp is taken literally. Both are
# read as UTC. An unparseable value is ignored, not treated as "hide".
NEXT_PUBLIC_NEPAL_BANNER_START=
NEXT_PUBLIC_NEPAL_BANNER_END=
