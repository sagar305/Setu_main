RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Premium QR Menu product links.
#
# NEXT_PUBLIC_* values are inlined at build time, so changing one needs a
# rebuild, not just a restart.
# ---------------------------------------------------------------------------

# The working demo anyone can click into.
NEXT_PUBLIC_QR_MENU_DEMO_URL=https://demo.qr-menu.setutechnology.com/

# The dashboard. "Create your account" links point at <this>/signup.
NEXT_PUBLIC_QR_MENU_APP_URL=https://app.qr-menu.setutechnology.com/

# On unless explicitly "false". Set it to false to point every "get started"
# link back at the product page — useful if the app needs to come down without
# shipping a code change.
NEXT_PUBLIC_QR_MENU_APP_ENABLED=true

# The QR Menu backend's API base, WITH its /api suffix. Server-only. Free Dine
# posts its menu to /api/qr-menu/pos/* here and this site forwards it, so the
# premium "sync from POS" works without adding this site to the API's CORS
# list. Unset, premium sync answers 503 and the free QR option still works.
QR_MENU_API_URL=

# ---------------------------------------------------------------------------
# URL shortener (optional).
#
# Leave these unset and every share link stays exactly as it was: the whole
# document travels inside the link, nothing is uploaded, and no shortening UI
# appears anywhere in the tools.
#
# Set all three to enable it. The service itself lives in the URL-shoternd-API
# repo (Express + MongoDB Atlas, deployed on Railway).
# ---------------------------------------------------------------------------

# Base URL of the deployed shortener. Server-side only — never NEXT_PUBLIC_.
SHORTENER_API_URL=https://setu-url-shortener.up.railway.app

# Must match API_KEY on the shortener service. This is the only thing stopping
# it from being an open shortener, so it must never reach a browser: keep it
# out of NEXT_PUBLIC_ variables and out of client components.
SHORTENER_API_KEY=

# Whether the tools show the "Shorten" button at all. Inlined at build time, so
# changing it needs a rebuild rather than a restart. Set to "true" only once the
# two values above are actually configured.
NEXT_PUBLIC_SHORT_LINKS_ENABLED=false

# ---------------------------------------------------------------------------
# Unreleased features.
#
# Server-only (no NEXT_PUBLIC_ prefix), so nothing we have not launched is
# readable from a browser, and read at build time — changing the value on
# Vercel does nothing until the project is redeployed. That redeploy is the
# launch.
#
# On Vercel: add the variable to Preview and Development so the team can work
# on the feature at a preview URL, and leave it off Production until launch
# day. See lib/featureFlags.ts.
# ---------------------------------------------------------------------------

# The Free Token System (/products/free-token-system, plus its display and
# view routes). Off unless "true": the three routes 404, and the product is
# absent from the sitemap, the products page and the toolkit registry.
TOKEN_SYSTEM_ENABLED=false

# The TB Analyser card on /products. Hidden unless "false". Only the card:
# /products/tb-analyzer, its app and the sitemaps stay live either way.
HIDE_TB_ANALYSER=true

# ---------------------------------------------------------------------------
# Usage analytics.
#
# Events are collected by our own /api/events route and forwarded from the
# server to PostHog. Nothing is sent from the browser to a third party, so an
# ad blocker cannot silently remove the numbers, and the key below never
# reaches a page. Leave POSTHOG_API_KEY unset and the route answers 501: the
# browser's queue notices after a few attempts and stops trying, so an
# unconfigured environment costs a handful of requests rather than a retry
# loop. Nothing else on the site is affected.
# ---------------------------------------------------------------------------

# Project API key from PostHog. Server-side only — never NEXT_PUBLIC_.
POSTHOG_API_KEY=

# Defaults to https://us.i.posthog.com, which is the region our project is in.
# Set this only if that ever changes. PostHog decides a project's region when
# it is created and cannot move it later, so check Settings > General > Region
# before assuming: pointing at the wrong one rejects every batch.
POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Setu QR Menu checkout (/products/qr-menu#buy).
#
# Indian buyers pay through Cashfree, everyone else through PayPal (see
# QR_MENU_USD_ENABLED). Cashfree keys from the dashboard.
# CASHFREE_ENV=production for live payments; anything else uses sandbox, whose
# keys are a different pair. The webhook URL to register in Cashfree is
# https://<site>/api/qr-menu/webhook.
#
# QR_MENU_LICENSE_SECRET must be the SAME value as on the QR Menu backend
# (menu-qr-generator-be), which redeems the keys this site sells. Changing it
# invalidates every key sold but not yet redeemed. Without it, or without the
# Cashfree keys, the buy box tells visitors payments are not set up.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
# Master switch for selling. Off unless "true": no Buy button or buy box,
# the payment return page 404s and the /api/qr-menu/* routes answer 404, even
# with the keys below set. The page reads it at build time, so redeploy after
# changing it. See qrMenuPaymentsEnabled() in lib/featureFlags.ts.
QR_MENU_PAYMENTS_ENABLED=false
# Charge buyers outside India in US dollars through PayPal. Off unless "true"
# AND the PayPal keys below are set: until then everyone pays the INR price
# through Cashfree. Indian buyers always pay through Cashfree.
QR_MENU_USD_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
QR_MENU_LICENSE_SECRET=

# PayPal REST app credentials (developer.paypal.com > Apps & Credentials), for
# buyers outside India. PAYPAL_ENV=production for live payments; anything else
# uses sandbox, whose app has a different client id and secret.
#
# Register a webhook on the same app at https://<site>/api/qr-menu/paypal-webhook
# for the CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.COMPLETED events, and put
# its id here. Without it the webhook answers 503 and a buyer who closes the tab
# after approving is only charged once they reopen the return page.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Optional seller details on the PDF invoice emailed with each key. With a
# GSTIN it becomes a "Tax Invoice" and an Indian price shows its CGST/SGST
# split (prices already include GST, so the total never changes). Write line
# breaks in the address as \n.
# SETU_INVOICE_GSTIN=
# SETU_INVOICE_ADDRESS="Office 12, Example Road\nMumbai 400001, Maharashtra"
